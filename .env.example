# ===========================================================================
#  A.O.A — environment variables
#
#  Copy this file to `.env.local` for local development, and set the same
#  values on your host (Vercel: Project -> Settings -> Environment Variables)
#  before deploying.
#
#  `.env.local` is git-ignored. This file, with no real values in it, is not.
#  Never put a real key in this file.
#
#  THE NEXT_PUBLIC_ PREFIX IS NOT COSMETIC. Any variable with that prefix is
#  compiled into the JavaScript every visitor downloads. The four unprefixed
#  variables below must never be given it.
# ===========================================================================

# --- Public: safe in the browser, and required there --------------------

# Your project URL, exactly as shown in Supabase under Settings -> API.
# The bare project origin — no trailing slash, and NOT the /rest/v1/ address
# the API docs show. The client appends that itself.
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co

# The "anon / public" key. Designed to be public; row level security is what
# limits it to published rows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The site's own address, used for canonical URLs, the sitemap, robots.txt
# and social preview images. Include the scheme, no trailing slash.
# Social previews and search listings will be wrong until this is correct.
NEXT_PUBLIC_SITE_URL=https://theaoacademy.org

# --- Secret: server only. Never prefix these with NEXT_PUBLIC_ ----------

# The "service_role" key from the same Supabase page. It bypasses row level
# security completely — anyone holding it can read and write every table,
# including every enquiry. Treat it like a database password.
SUPABASE_SERVICE_ROLE_KEY=

# The single administrator's sign-in.
ADMIN_EMAIL=you@example.com

# Use a long random password — it is the only thing protecting the admin.
# Generate one:  node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
ADMIN_PASSWORD=

# Signs the admin session cookie. Must be at least 32 characters, and must
# NOT be the same string as ADMIN_PASSWORD. Changing it signs everyone out.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SECRET=
